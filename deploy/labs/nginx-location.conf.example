# Native nginx/openresty example. This strips /labs before forwarding, so the
# builds are available at https://your-host.example/labs/tactics/ and
# https://your-host.example/labs/composition/.
location = /labs {
    return 308 /labs/;
}

# Answer the trailing-slash redirects here rather than letting them reach the
# container. The container is mounted under /labs but does not know it, so a
# redirect it issues names a path relative to its own root and arrives at the
# browser missing the prefix. Add one line per lab.
location = /labs/tactics {
    return 308 /labs/tactics/;
}

location = /labs/composition {
    return 308 /labs/composition/;
}

location /labs/ {
    proxy_pass http://127.0.0.1:8086/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 120s;

    # A safety net for redirects other than the trailing-slash ones handled
    # above. The container sets `absolute_redirect off`, so what it issues is
    # root-relative and has lost the /labs prefix by the time it reaches the
    # browser; this puts the prefix back. `proxy_redirect default` does not
    # cover it - that only rewrites absolute URLs matching proxy_pass.
    proxy_redirect ~^/(.*)$ /labs/$1;
}
